<?xml version="1.0" encoding="utf-8"?>
<!--
  KHUSUS build DEBUG & PROFILE (menimpa src/main/res/xml/network_security_config.xml).
  Mengizinkan HTTP polos (cleartext) agar app bisa terhubung ke backend DEV
  yang berjalan di LAN/localhost (http://…). Build rilis memakai versi ketat
  di src/main yang menolak cleartext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Host backend dev yang dipakai (sesuaikan bila IP berubah). -->
        <domain includeSubdomains="true">192.0.18.51</domain>
        <domain includeSubdomains="true">192.0.88.24</domain>
        <domain includeSubdomains="true">192.168.1.20</domain>
        <!-- Loopback: emulator Android (10.0.2.2) + localhost. -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
