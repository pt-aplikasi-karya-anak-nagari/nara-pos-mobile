<?xml version="1.0" encoding="utf-8"?>
<!--
  Konfigurasi jaringan build RILIS: hanya HTTPS, hanya sertifikat CA sistem.
    - cleartextTrafficPermitted="false": HTTP polos ditolak, jadi token & data
      transaksi tak pernah lewat jaringan tanpa enkripsi.
    - Hanya trust-anchor "system": sertifikat CA yang dipasang pengguna (cara
      umum menyadap HTTPS dengan proxy seperti Burp/mitmproxy) TIDAK dipercaya.
  Build debug & profile memakai salinan longgar di src/debug & src/profile.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
