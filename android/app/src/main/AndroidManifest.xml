<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- ══════════════════ IZIN SISTEM ══════════════════
         Diminta di muka lewat gerbang izin (lib/features/izin), sebelum login.

         SEBELUM INI TAK ADA SATU PUN <uses-permission> DI SINI. Yang membuat
         cetak Bluetooth tetap jalan adalah manifest milik plugin
         print_bluetooth_thermal, yang ikut ter-merge — bukan berkas ini.
         Bergantung pada itu rapuh: satu pembaruan plugin yang mencabutnya akan
         mematikan pencetakan struk tanpa satu baris pun berubah di repo ini.
         Karena itu izin intinya dideklarasikan ulang di sini secara eksplisit;
         deklarasi kembar yang identik digabung diam-diam oleh manifest merger.

         permission_handler TIDAK menyumbang izin apa pun — daftar panjang di
         paketnya milik aplikasi CONTOH-nya, bukan pluginnya. -->

    <!-- Printer struk thermal. BLUETOOTH & BLUETOOTH_ADMIN untuk Android <= 11;
         sejak Android 12 keduanya digantikan SCAN & CONNECT. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Lokasi. Dua pemakai:
         - Android <= 11 menolak memindai perangkat Bluetooth (printer) tanpa
           izin lokasi;
         - absensi: outlet yang mewajibkan radius lokasi memeriksa posisi saat
           absen masuk/pulang (internal/attendance/aturan.go di backend).
         Dulu dibatasi maxSdkVersion=30 karena hanya dipakai Bluetooth. Kini
         diperlukan di semua versi; tools:node="replace" menimpa deklarasi
         ber-maxSdkVersion dari manifest plugin supaya batas itu tak ikut
         ter-merge. Izin hanya DIMINTA saat absen di outlet yang mewajibkannya. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:node="replace" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"
        tools:node="replace" />

    <!-- Android 13+ menahan SEMUA notifikasi sampai izin ini diberikan.
         Aplikasi ini memakai FCM untuk memberitahu kasir ada pesanan QR baru;
         tanpa deklarasi ini pemberitahuan itu tak pernah muncul di Android 13+,
         tanpa galat dan tanpa apa pun yang bisa dilihat. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Pemindai barcode produk (mobile_scanner). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Penyimpanan cadangan data offline (transaksi, produk, add-on) yang
         tetap ada setelah aplikasi di-uninstall dan terbaca lagi setelah
         install ulang — lihat FolderOfflineChannel.kt.

         Android 11+: hanya MANAGE_EXTERNAL_STORAGE ("Akses semua file") yang
         mengizinkan aplikasi yang di-install ulang membaca file lamanya
         sendiri di penyimpanan bersama. Play Store membatasi izin ini; aplikasi
         ini dibagikan sebagai APK.
         Android 10 ke bawah: WRITE_EXTERNAL_STORAGE (+ requestLegacyExternalStorage
         untuk Android 10). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:label="NARA POS"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Ikon/warna/channel default untuk notifikasi FCM yang dirender OS saat
             app di BACKGROUND / KILLED (jalur utama alert pesanan baru ke kasir).
             Tanpa ini, OS fallback ke @mipmap/ic_launcher (logo full-color) yang
             digambar sebagai kotak putih di status bar — persis bug yang
             ic_notification.xml dibuat untuk hindari. Small-icon HARUS silhouette
             putih transparan. channel_id harus cocok dgn _fcmChannelId di
             lib/core/notifications.dart. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="mako_fcm_v3" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Suara panggilan antrian (flutter_tts): Android 11+ hanya
             menampilkan mesin Text-to-Speech yang dideklarasikan di sini. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Diperlukan url_launcher (Android 11+) agar bisa membuka URL
             eksternal (mis. struk/invoice, tautan) di browser. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
